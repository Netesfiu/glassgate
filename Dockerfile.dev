# Fejlesztői környezet beállítása
FROM node:22-bookworm-slim

# Fejlesztői mód beállítása
ENV NODE_ENV=development

# Build és futásidejű függőségek telepítése
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    pkg-config \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libjpeg62-turbo \
    libgif7 \
    libpixman-1-0 \
    libfontconfig1 \
    fonts-dejavu-core \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg62-turbo-dev \
    libgif-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Package fájlok másolása
COPY package*.json ./

# Minden függőség telepítése, beleértve a fejlesztői függőségeket is
RUN npm install

# Alkalmazás fájlok másolása
COPY . .

# Nem root felhasználó determinisztikus, numerikus UID/GID-del (lásd Dockerfile.prod)
RUN groupadd -g 10001 appgroup \
    && useradd -u 10001 -g 10001 -M -d /app -s /usr/sbin/nologin appuser \
    && mkdir -p /app/logs \
    && chown -R 10001:10001 /app

USER 10001:10001

EXPOSE 3000
CMD ["node", "server.js"]
